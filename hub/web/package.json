{
  "name": "agentlab-hub",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun run check && vite build",
    "check": "tsc --noEmit && eslint . --max-warnings 0 && prettier --check .",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "browserslist": [
    "chrome >= 123",
    "edge >= 123",
    "safari >= 17.5",
    "ios_saf >= 17.5",
    "firefox >= 120"
  ],
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@stylexjs/stylex": "0.19.1",
    "@tanstack/react-query": "5.62.7",
    "qrcode": "1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@stylexjs/eslint-plugin": "0.19.1",
    "@stylexjs/unplugin": "0.19.1",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.1.0",
    "@types/qrcode": "1.5.5",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "jsdom": "25.0.1",
    "prettier": "3.9.7",
    "typescript": "5.6.3",
    "typescript-eslint": "8.71.2",
    "vite": "6.4.4",
    "vitest": "4.1.12"
  }
}
