{
  "name": "agentlab-hub",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun run verify && vite build",
    "verify": "bun run typecheck && bun run lint && bun run format:check",
    "typecheck": "bun check --no-script",
    "lint": "oxlint --type-aware --deny-warnings",
    "format": "bun fmt --no-script",
    "format:check": "bun fmt --no-script --check",
    "test": "vitest run"
  },
  "browserslist": [
    "chrome >= 123",
    "edge >= 123",
    "safari >= 17.5",
    "ios_saf >= 17.5",
    "firefox >= 120"
  ],
  "dependencies": {
    "@stylexjs/stylex": "0.19.2",
    "@tanstack/react-query": "5.108.0",
    "@ui-sdk/core": "0.1.0-beta.13",
    "@ui-sdk/react": "0.1.0-beta.5",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@stylexjs/eslint-plugin": "0.19.2",
    "@stylexjs/unplugin": "0.19.2",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.1",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
