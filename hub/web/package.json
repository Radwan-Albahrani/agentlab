{
  "name": "agentlab-hub",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun run verify && vite build",
    "verify": "bun run typecheck && bun run lint && bun run format:check",
    "typecheck": "bun check --no-script",
    "lint": "oxlint --type-aware --deny-warnings",
    "format": "bun fmt --no-script",
    "format:check": "bun fmt --no-script --check",
    "test": "vitest run"
  },
  "browserslist": [
    "chrome >= 123",
    "edge >= 123",
    "safari >= 17.5",
    "ios_saf >= 17.5",
    "firefox >= 120"
  ],
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@stylexjs/stylex": "0.19.1",
    "@tanstack/react-query": "5.105.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@stylexjs/eslint-plugin": "0.19.1",
    "@stylexjs/unplugin": "0.19.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
