{
  "name": "agentlab-hub",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun run check && vite build",
    "check": "tsc --noEmit && eslint . --max-warnings 0 && prettier --check .",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "browserslist": [
    "chrome >= 123",
    "edge >= 123",
    "safari >= 17.5",
    "ios_saf >= 17.5",
    "firefox >= 120"
  ],
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@stylexjs/stylex": "0.19.1",
    "@tanstack/react-query": "5.105.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stylexjs/eslint-plugin": "0.19.1",
    "@stylexjs/unplugin": "0.19.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
