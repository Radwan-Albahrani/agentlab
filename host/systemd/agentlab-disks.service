# Must run before Docker, or agents start on empty folders and write to the host's disk instead of their image.
[Unit]
Description=agentlab: mount agent storage images
Before=docker.service
After=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=AGENTLAB_CLUSTER=@CLUSTER@
ExecStart=/usr/bin/python3 @REPO@/host/bin/agentlab-mount-storage

[Install]
WantedBy=multi-user.target
