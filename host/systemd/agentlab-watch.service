# The hub's hands on the host: its buttons and the agents' companion requests within a second, usage and
# inventory every 30 s. Always on (not a timer) so requests don't wait for the next tick.
[Unit]
Description=agentlab: watcher for the hub
After=docker.service agentlab-disks.service

[Service]
WorkingDirectory=@REPO@/host
Environment=PYTHONDONTWRITEBYTECODE=1 AGENTLAB_CLUSTER=@CLUSTER@ AGENTLAB_CONFIG=@CONFIG@
ExecStart=/usr/bin/python3 -m watch
Restart=always
RestartSec=5
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
WantedBy=multi-user.target
