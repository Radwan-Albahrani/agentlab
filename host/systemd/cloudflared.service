# Token comes from a root-only file, never the command line (readable by every local user).
[Unit]
Description=cloudflared tunnel for agentlab
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/bin/sh -c 'TUNNEL_TOKEN="$(cat @DATA@/secrets/cloudflare-tunnel.token)" exec /usr/bin/cloudflared --no-autoupdate tunnel run'
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
