#!/bin/bash
# Playwright MCP launches Chrome through this: start the (normally off) virtual display first.
supervisorctl -c /etc/agent-supervisord.conf start xvfb vnc novnc >/dev/null 2>&1
for _ in $(seq 50); do [ -S /tmp/.X11-unix/X99 ] && break; sleep 0.1; done
# With no Chrome running, a profile lock is stale.
pgrep -f '/opt/google/chrome/chrome' >/dev/null || rm -f "$HOME"/.chrome-profile/Singleton{Lock,Socket,Cookie}
exec /opt/google/chrome/chrome "$@"
