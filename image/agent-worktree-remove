#!/bin/bash
# Removes the worktrees named on stdin (agent-side paths), as the agent. Unsaved work (uncommitted changes, commits on
# no remote) is kept as refs/agentlab/removed/<name> in the main repository first, once untouched NOTICE_DAYS (0: at
# once); a worktree without a commit has nothing to keep. DISCARD=1 keeps nothing (a finished PR review's checkouts:
# they only read the code). DRY=1 only lists. Used by the host's janitor and the companion bridge's release
# (accounts/bridge.py).
NOTICE_DAYS=${NOTICE_DAYS:-3}
removed="" kept="" n=0 now=$(date +%s)
while read -r wt; do
  [ -e "${wt}/.git" ] || continue
  name=${wt#/workspace/worktrees/}
  main=$(dirname "$(git -C "${wt}" rev-parse --path-format=absolute --git-common-dir)")
  if [ -n "${DISCARD}" ]; then
    if [ -n "${DRY}" ] || git -C "${main}" worktree remove --force --force "${wt}" 2>/dev/null; then
      removed+=" ${name}"; n=$((n + 1))
    else kept+=" ${name} (git refused)"; fi
    continue
  fi
  head=$(git -C "${wt}" rev-parse -q --verify HEAD 2>/dev/null)
  if [ -z "${head}" ]; then
    if [ -n "${DRY}" ] || git -C "${main}" worktree remove --force "${wt}" 2>/dev/null; then
      removed+=" ${name} (no commit)"; n=$((n + 1))
    else kept+=" ${name} (git refused)"; fi
    continue
  fi
  changes=$(git -C "${wt}" status --porcelain | grep -v node_modules)
  dirty=$(printf '%s' "${changes}" | grep -c .)
  unpushed=$(git -C "${wt}" rev-list --count HEAD --not --remotes)
  if [ "${dirty}" -eq 0 ] && [ "${unpushed}" -eq 0 ]; then
    if [ -n "${DRY}" ] || git -C "${main}" worktree remove --force "${wt}" 2>/dev/null; then
      removed+=" ${name}"; n=$((n + 1))
    else kept+=" ${name} (git refused)"; fi
    continue
  fi
  why=""
  [ "${dirty}" -gt 0 ] && why="${dirty} uncommitted"
  [ "${unpushed}" -gt 0 ] && why="${why:+${why}, }${unpushed} commits on no remote"
  last=$(git -C "${wt}" log -1 --format=%ct HEAD 2>/dev/null || echo 0)
  while read -r f; do
    [ -n "${f}" ] || continue
    t=$(stat -c %Y "${wt}/${f}" 2>/dev/null || echo 0)
    [ "${t}" -gt "${last}" ] && last=${t}
  done <<< "$(printf '%s\n' "${changes}" | cut -c4- | sed 's/.* -> //')"
  due=$((last + NOTICE_DAYS * 86400))
  if [ "${now}" -lt "${due}" ]; then kept+=" ${name} (${why}; removed $(date -d "@${due}" +%b-%d) if untouched)"; continue; fi
  ref="refs/agentlab/removed/${name//\//-}"
  if [ -n "${DRY}" ]; then removed+=" ${name} (${why})"; n=$((n + 1)); continue; fi
  git -C "${wt}" add -A -- . ':!node_modules' 2>/dev/null
  snap=$(git -C "${wt}" stash create 2>/dev/null)
  if git -C "${main}" update-ref "${ref}" "${snap:-${head}}" \
     && git -C "${main}" worktree remove --force "${wt}" 2>/dev/null; then
    removed+=" ${name} (${why}; saved as ${ref})"; n=$((n + 1))
  else kept+=" ${name} (git refused)"; fi
done
[ -n "${DRY}" ] || for r in /workspace/*/; do [ -d "${r}.git" ] && git -C "${r}" worktree prune; done
echo "$([ -n "${DRY}" ] && echo "would remove" || echo removed) ${n} worktrees:${removed:- none}${kept:+; kept:${kept}}"
