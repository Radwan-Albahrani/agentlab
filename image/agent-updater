#!/usr/bin/env python3
"""Keeps the agent's own tools current without anyone restarting anything (supervisord program `updater`).

Every AGENTLAB_UPDATE_HOURS (default 6; 0 = never install) it re-runs the same installers the entrypoint uses
(/etc/agent/tools.sh). The CLIs pick up new versions on their next run, but a running T3 server keeps the version it
started with, so whenever the installed T3 is newer than the running one, it restarts ONLY the t3 program, and only
while no T3 run is in progress (a restart mid-turn would cut it off). Busy: it checks again every few minutes, for up
to AGENTLAB_UPDATE_WAIT_HOURS (default 4). Still busy then, AGENTLAB_ON_BUSY decides: "defer" (default) waits for the
next update cycle; "resume" restarts T3 anyway and sends each chat whose turn it cut off a message to carry on.

The first check comes ~2 min after start, so a T3 installed while the server was already starting is picked up too."""

import os
import re
import sqlite3
import subprocess
import time

HOME = os.path.expanduser('~')
HOURS = float(os.environ.get('AGENTLAB_UPDATE_HOURS') or 6)
STAMP = os.path.join(HOME, '.config', 'agent', 'tools-updated')
T3_DB = os.path.join(HOME, '.t3', 'userdata', 'statev2.sqlite')
SUPERVISOR = ['supervisorctl', '-c', '/etc/agent-supervisord.conf']
WAIT_HOURS = float(os.environ.get('AGENTLAB_UPDATE_WAIT_HOURS') or 4)
ON_BUSY = os.environ.get('AGENTLAB_ON_BUSY') or 'defer'
CONTINUE = 'The server restarted for an update; continue where you left off.'
FIRST_CHECK_S = 120
RETRY_S = 300
SETTLED = ('completed', 'cancelled', 'failed', 'interrupted')  # every other run status means a turn is in progress


def log(msg):
    print(time.strftime('%Y-%m-%d %H:%M:%S'), msg, flush=True)


def due(now=None):
    """Installers ran longer ago than HOURS (or never)."""
    if HOURS <= 0:
        return False
    try:
        return (now or time.time()) - os.path.getmtime(STAMP) >= HOURS * 3600
    except OSError:
        return True


def update_tools(run=subprocess.run):
    log('updating tools')
    cmd = 'set -u; . /etc/agent/tools.sh; update_tools'
    run(['nice', '-n', '15', 'ionice', '-c3', 'bash', '-c', cmd], check=False)
    os.makedirs(os.path.dirname(STAMP), exist_ok=True)
    with open(STAMP, 'a'):
        os.utime(STAMP)


def version(text):
    m = re.search(r'(\d+\.\d+\.\d+[\w.-]*)', text or '')
    return m.group(1) if m else ''


def installed_t3(run=subprocess.run):
    p = run(['bash', '-lc', 't3 --version'], capture_output=True, text=True, check=False)
    return version(p.stdout) if p.returncode == 0 else ''


def running_t3(ps=None):
    """The version the T3 server runs, from its binary's path (~/.t3/runtime/versions/<v>/t3); '' when not running."""
    if ps is None:
        ps = subprocess.run(['ps', '-eo', 'args'], capture_output=True, text=True, check=False).stdout
    found = sorted({m for m in re.findall(r'/\.t3/runtime/versions/(\d[\w.-]*)/', ps)})
    return found[-1] if found else ''


def inflight(db=T3_DB):
    """[(run id, thread id)] of turns in progress."""
    try:
        with sqlite3.connect(f'file:{db}?mode=ro', uri=True, timeout=5) as c:
            marks = ','.join('?' * len(SETTLED))
            q = f'select run_id, thread_id from orchestration_v2_projection_runs where status not in ({marks})'
            return [tuple(r) for r in c.execute(q, SETTLED)]
    except sqlite3.Error:
        return []


def statuses(run_ids, db=T3_DB):
    try:
        with sqlite3.connect(f'file:{db}?mode=ro', uri=True, timeout=5) as c:
            marks = ','.join('?' * len(run_ids))
            q = f'select run_id, status from orchestration_v2_projection_runs where run_id in ({marks})'
            return dict(c.execute(q, list(run_ids)).fetchall())
    except sqlite3.Error:
        return {}


def idle(db=T3_DB):
    """No T3 run in progress. Unreadable DB counts as busy: better a later restart than a cut-off turn."""
    try:
        with sqlite3.connect(f'file:{db}?mode=ro', uri=True, timeout=5) as c:
            marks = ','.join('?' * len(SETTLED))
            (n,) = c.execute(f'select count(*) from orchestration_v2_projection_runs where status not in ({marks})', SETTLED).fetchone()
        return n == 0
    except sqlite3.Error:
        return False


def align_t3(run=subprocess.run, ps=None, db=T3_DB):
    """Restart the t3 program onto the installed version when it differs and nothing is running.
    -> 'current' | 'restarted' | 'busy' | 'unknown'"""
    have, want = running_t3(ps), installed_t3(run)
    if not have or not want:
        return 'unknown'
    if have == want:
        return 'current'
    if not idle(db):
        log(f'T3 {want} is installed but {have} is running and a turn is in progress; trying again later')
        return 'busy'
    log(f'restarting T3 {have} -> {want} (idle)')
    run([*SUPERVISOR, 'restart', 't3'], check=False)
    return 'restarted'


def t3_up(run=subprocess.run, sleep=time.sleep, timeout_s=300):
    for _ in range(int(timeout_s / 5)):
        p = run(['curl', '-fs', '-o', '/dev/null', 'http://127.0.0.1:3773/'], check=False)
        if p.returncode == 0:
            return True
        sleep(5)
    return False


def resume_t3(run=subprocess.run, db=T3_DB, sleep=time.sleep):
    """Restart t3 although a turn is running, then tell each chat it cut off to continue. -> threads told"""
    running = inflight(db)
    log(f'restarting T3 although {len(running)} turn(s) are running; they will be told to continue')
    run([*SUPERVISOR, 'restart', 't3'], check=False)
    if not t3_up(run, sleep):
        log('T3 did not come back within 5 min; the interrupted chats were not resumed')
        return []
    now = statuses([r for r, _ in running], db) if running else {}
    told = []
    for run_id, thread in running:
        if now.get(run_id) != 'interrupted' or thread in told:
            continue
        p = run(['t3', 'thread', 'send', '--json', thread, '-'], input=CONTINUE, text=True, capture_output=True,
                cwd='/workspace', check=False)
        if p.returncode == 0:
            told.append(thread)
        else:
            log(f'could not tell chat {thread} to continue: {(p.stderr or p.stdout or "").strip()[:200]}')
    log(f'resumed {len(told)} chat(s)')
    return told


class Waiter:
    """How long T3 has been held back by a busy agent, and what to do at the end of the wait."""

    def __init__(self, clock=time.time):
        self.clock, self.since, self.until = clock, None, 0

    def step(self, run=subprocess.run, ps=None, db=T3_DB, sleep=time.sleep):
        """One check. -> 'current' | 'restarted' | 'busy' | 'resumed' | 'deferred' | 'unknown'"""
        if self.clock() < self.until:
            return 'deferred'
        state = align_t3(run, ps, db)
        if state != 'busy':
            self.since = None
            return state
        self.since = self.since or self.clock()
        if self.clock() - self.since < WAIT_HOURS * 3600:
            return 'busy'
        self.since = None
        if ON_BUSY == 'resume':
            resume_t3(run, db, sleep)
            return 'resumed'
        log(f'T3 busy for {WAIT_HOURS:g} h; the new version waits for the next cycle')
        self.until = self.clock() + max(HOURS, 1) * 3600
        return 'deferred'


def main():
    time.sleep(FIRST_CHECK_S)
    waiter = Waiter()
    while True:
        if due():
            update_tools()
        state = waiter.step()
        time.sleep(RETRY_S if state == 'busy' else 600)


if __name__ == '__main__':
    main()
