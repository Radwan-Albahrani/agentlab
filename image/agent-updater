#!/opt/agent-t3/bin/python3
"""Supervisord program `updater`: re-runs tools.sh installers and restarts t3 (and the account pool) onto a new
version only while idle."""

import json
import os
import re
import subprocess
import time
from collections.abc import Callable
from typing import Any, Literal

from sqlalchemy.exc import SQLAlchemyError

import t3state

HOME = os.path.expanduser('~')
HOURS = float(os.environ.get('AGENTLAB_UPDATE_HOURS') or 6)
STAMP = os.path.join(HOME, '.config', 'agent', 'tools-updated')
T3_DB = t3state.DB
WAITING = os.path.join(HOME, '.config', 'agent', 't3-update.json')  # read by the hub (via /api/summary)
POOL_VERSION = '/tmp/pool-version'  # written by the pool program as it starts
SUPERVISOR = ['supervisorctl', '-c', '/etc/agent-supervisord.conf']
WAIT_HOURS = float(os.environ.get('AGENTLAB_UPDATE_WAIT_HOURS') or 4)
ON_BUSY = os.environ.get('AGENTLAB_ON_BUSY') or 'defer'
FIRST_CHECK_S = 120
RETRY_S = 300

Run = Callable[..., subprocess.CompletedProcess[Any]]
# Where a new version stands: a restart only from busy -> idle, deferred until the next cycle after WAIT_HOURS busy.
Aligned = Literal['current', 'restarted', 'busy', 'unknown']
Step = Literal['current', 'restarted', 'busy', 'resumed', 'deferred', 'unknown']


def log(msg: str) -> None:
    print(time.strftime('%Y-%m-%d %H:%M:%S'), msg, flush=True)


def due(now: float | None = None) -> bool:
    if HOURS <= 0:
        return False
    try:
        return (now or time.time()) - os.path.getmtime(STAMP) >= HOURS * 3600
    except OSError:
        return True


def update_tools(run: Run = subprocess.run) -> None:
    log('updating tools')
    cmd = 'set -u; . /etc/agent/tools.sh; update_tools'
    run(['nice', '-n', '15', 'ionice', '-c3', 'bash', '-c', cmd], check=False)
    os.makedirs(os.path.dirname(STAMP), exist_ok=True)
    with open(STAMP, 'a'):
        os.utime(STAMP)


def version(text: str | None) -> str:
    m = re.search(r'(\d+\.\d+\.\d+[\w.-]*)', text or '')
    return m.group(1) if m else ''


def installed_t3(run: Run = subprocess.run) -> str:
    p = run(['bash', '-lc', 't3 --version'], capture_output=True, text=True, check=False)
    return version(p.stdout) if p.returncode == 0 else ''


def running_t3(ps: str | None = None) -> str:
    """The running T3 server's version, from its binary's path; '' when not running."""
    if ps is None:
        ps = subprocess.run(['ps', '-eo', 'args'], capture_output=True, text=True, check=False).stdout
    found = sorted(set(re.findall(r'/\.t3/runtime/versions/(\d[\w.-]*)/', ps)))
    return found[-1] if found else ''


def idle(db: str = T3_DB) -> bool:
    """No T3 run in progress; a run with an end time or a finished status is over. Unreadable counts as busy."""
    try:
        with t3state.reading(db) as session:
            return not t3state.busy(session)
    except SQLAlchemyError:
        return False


def note_waiting(have: str, want: str, path: str | None = None, now: float | None = None) -> None:
    """Record since when `want` waits behind `have`; the hub warns when that gets long; no `want` clears it."""
    path = path or WAITING
    if not want:
        if os.path.exists(path):
            os.remove(path)
        return
    try:
        with open(path) as f:
            old = json.load(f)
    except (OSError, ValueError):
        old = {}
    since = old['since'] if old.get('installed') == want and old.get('since') else (now or time.time())
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, 'w') as f:
        json.dump({'installed': want, 'running': have, 'since': since}, f)


def align_t3(run: Run = subprocess.run, ps: str | None = None, db: str = T3_DB, waiting: str | None = None) -> Aligned:
    """-> 'current' | 'restarted' | 'busy' | 'unknown'"""
    have, want = running_t3(ps), installed_t3(run)
    if not have or not want:
        return 'unknown'
    if have == want:
        note_waiting('', '', waiting)
        return 'current'
    if not idle(db):
        log(f'T3 {want} is installed but {have} is running and a turn is in progress; trying again later')
        note_waiting(have, want, waiting)
        return 'busy'
    log(f'restarting T3 {have} -> {want} (idle)')
    run([*SUPERVISOR, 'restart', 't3'], check=False)
    note_waiting('', '', waiting)
    return 'restarted'


def resume_t3(run: Run = subprocess.run) -> None:
    """Restart t3 mid-turn; T3 resumes cut-off turns itself, so nothing is sent to them."""
    log('restarting T3 although a turn is running; T3 resumes it after the restart')
    run([*SUPERVISOR, 'restart', 't3'], check=False)
    note_waiting('', '')


def align_pool(run: Run = subprocess.run, db: str = T3_DB, started: str = POOL_VERSION) -> Aligned:
    """Restart a running account pool onto a newer TeamClaude while idle (a restart cuts requests in flight)."""
    try:
        with open(started) as f:
            have = version(f.read())
    except OSError:
        return 'unknown'  # not running
    p = run(['bash', '-lc', 'teamclaude --version'], capture_output=True, text=True, check=False)
    want = version(p.stdout) if p.returncode == 0 else ''
    if not have or not want or have == want:
        return 'current' if have and have == want else 'unknown'
    if not idle(db):
        return 'busy'
    log(f'restarting the account pool {have} -> {want} (idle)')
    run([*SUPERVISOR, 'restart', 'pool'], check=False)
    return 'restarted'


class Waiter:
    def __init__(self, clock: Callable[[], float] = time.time) -> None:
        self.clock = clock
        self.since: float | None = None
        self.until = 0.0

    def step(
        self,
        run: Run = subprocess.run,
        ps: str | None = None,
        db: str = T3_DB,
        sleep: Callable[[float], None] = time.sleep,
    ) -> Step:
        """-> 'current' | 'restarted' | 'busy' | 'resumed' | 'deferred' | 'unknown'"""
        if self.clock() < self.until:
            return 'deferred'
        state = align_t3(run, ps, db)
        if state != 'busy':
            self.since = None
            return state
        self.since = self.since or self.clock()
        if self.clock() - self.since < WAIT_HOURS * 3600:
            return 'busy'
        self.since = None
        if ON_BUSY == 'resume':
            resume_t3(run)
            return 'resumed'
        log(f'T3 busy for {WAIT_HOURS:g} h; the new version waits for the next cycle')
        self.until = self.clock() + max(HOURS, 1) * 3600
        return 'deferred'


def main() -> None:
    time.sleep(FIRST_CHECK_S)
    waiter = Waiter()
    while True:
        if due():
            update_tools()
        state = waiter.step()
        align_pool()
        time.sleep(RETRY_S if state == 'busy' else 600)


if __name__ == '__main__':
    main()
