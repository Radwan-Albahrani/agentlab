#!/usr/bin/env python3
"""Keeps a throttle shim linked for exactly the heavy tools installed, re-syncing on inotify changes."""

import ctypes
import os
import re
import time

SHIMS = '/usr/local/lib/agent-shims'
SHIM = '/usr/local/lib/agent-throttle/shim'
HOME = os.path.expanduser('~')
TOOL_DIRS = [
    '/home/linuxbrew/.linuxbrew/bin',
    '/home/linuxbrew/.linuxbrew/sbin',
    f'{HOME}/.local/bin',
    f'{HOME}/.npm-global/bin',
    f'{HOME}/.cargo/bin',
    f'{HOME}/go/bin',
    f'{HOME}/.bun/bin',
    '/usr/local/go/bin',
    '/usr/local/bin',
    '/usr/bin',
    '/bin',
]
CHANGES = 0x4 | 0x40 | 0x80 | 0x100 | 0x200 | 0x400 | 0x800  # attrib, moved from/to, create, delete, delete/move self
SETTLE_S = 0.3

libc = ctypes.CDLL('libc.so.6', use_errno=True)


def heavy_tools():
    """Tool names from the shim's TOOLS line."""
    with open(SHIM) as f:
        return set(re.search(r'^TOOLS="(.*)"$', f.read(), re.M).group(1).split())


def installed(tool):
    return any(os.path.isfile(p) and os.access(p, os.X_OK) for p in (os.path.join(d, tool) for d in TOOL_DIRS))


def sync(tools):
    for tool in tools:
        link = os.path.join(SHIMS, tool)
        if installed(tool):
            if not os.path.islink(link):
                os.symlink('../agent-throttle/shim', link)
        elif os.path.lexists(link):
            os.remove(link)
    for stray in set(os.listdir(SHIMS)) - tools:
        os.remove(os.path.join(SHIMS, stray))


def nearest_existing(path):
    while not os.path.isdir(path):
        path = os.path.dirname(path)
    return path


def watch_tool_folders():
    """inotify fd on every tool folder (or its nearest existing parent)."""
    fd = libc.inotify_init1(os.O_CLOEXEC)
    for folder in {nearest_existing(d) for d in TOOL_DIRS}:
        libc.inotify_add_watch(fd, folder.encode(), CHANGES)
    return fd


def main():
    tools = heavy_tools()
    os.makedirs(SHIMS, exist_ok=True)
    while True:
        fd = watch_tool_folders()  # before the sync, so no change is missed
        sync(tools)
        os.read(fd, 65536)
        os.close(fd)
        time.sleep(SETTLE_S)


if __name__ == '__main__':
    main()
