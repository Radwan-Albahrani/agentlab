#!/usr/bin/env python3
"""Per-start configuration the entrypoint delegates:
agent-config codex <config.toml> <command>   register the browser tool in Codex's config, replacing any older form
agent-config notes <agent id> [--android]    environment notes for the agents (CLAUDE.md / AGENTS.md belong to them)
agent-config skills                          install our skills for Claude Code and Codex (only our own folders)"""

import os
import re
import shutil
import sys
import tomllib

INSTRUCTIONS = '/etc/agent/agent-instructions.md'
BUILTIN_BEGIN = '# BEGIN agent-builtin (written by the container entrypoint on every start)'
ALREADY_TOLD = ('agent-environment', 'Your environment (agent:', 'Your environment (agent profile')
# Our span of CLAUDE.md / AGENTS.md; every byte outside it belongs to the agent.
BLOCK = re.compile(r'<!-- BEGIN agent-environment\b[^\n]*?-->(\r?\n)(.*?)<!-- END agent-environment -->', re.S)
BLOCK_BEGIN = '<!-- BEGIN agent-environment (managed by agentlab; edits here are overwritten) -->'
BLOCK_END = '<!-- END agent-environment -->'
SKILLS = '/etc/agent/skills'
MANAGED = '.agentlab-managed'  # marks a skill folder as ours to replace


def read(path):
    if not os.path.exists(path):
        return ''
    with open(path) as f:
        return f.read()


def codex_with_browser(text, command):
    """Codex config with exactly one browser-tool entry; `codex mcp` rewrites can drop our markers, so strip all forms."""
    text = re.sub(r'\n?# BEGIN agent-builtin.*?# END agent-builtin\n?', '\n', text, flags=re.S)
    text = re.sub(r'^\[mcp_servers\.playwright(\.[^\]]+)?\]\n(?:(?![\[#])[^\n]*\n?)*', '', text, flags=re.M)
    text = re.sub(r'^# (BEGIN|END) agent-builtin.*\n?', '', text, flags=re.M)
    text = re.sub(r'\n{3,}', '\n\n', text).rstrip()
    if not re.search(r'^cli_auth_credentials_store', text, re.M):  # no keyring in containers
        text = 'cli_auth_credentials_store = "file"\n' + text
    block = (
        f'{BUILTIN_BEGIN}\n[mcp_servers.playwright]\ncommand = "{command}"\nargs = []\n'
        'env = { DISPLAY = ":99" }\nstartup_timeout_sec = 60\n# END agent-builtin\n'
    )
    return f'{text}\n\n{block}'


def write_codex(path, command):
    updated = codex_with_browser(read(path), command)
    tomllib.loads(updated)  # never write a config Codex can't read
    with open(path, 'w') as f:
        f.write(updated)


def sections(text, keep):
    """Keep or drop each optional <!-- name --> ... <!-- /name --> section."""
    for name, on in keep.items():
        if not on:
            text = re.sub(rf'<!-- {name} -->.*?<!-- /{name} -->\n?', '', text, flags=re.S)
        text = re.sub(rf'<!-- /?{name} -->\n?', '', text)
    return text.strip()


def refresh_block(text, body):
    """`text` with its managed block's content replaced by `body` (line endings kept), or None if it has none."""
    m = BLOCK.search(text)
    if not m:
        return None
    nl = m.group(1)
    inner = body.replace('\r\n', '\n').replace('\n', nl)
    return text[: m.start()] + BLOCK_BEGIN + nl + inner + nl + BLOCK_END + text[m.end() :]


def _raw(path):
    """The file with line endings kept, or None when missing or not UTF-8."""
    try:
        with open(path, encoding='utf-8', newline='') as f:
            return f.read()
    except (FileNotFoundError, UnicodeDecodeError):
        return None


def write_notes(agent, home, android=False, companions=()):
    """Write environment.md and refresh (or append once) our block in CLAUDE.md (@import) and AGENTS.md (text)."""
    text = read(INSTRUCTIONS).replace('{{AGENT_ID}}', agent).replace('{{COMPANIONS}}', ', '.join(companions))
    text = sections(text, {'android': android, 'companions': bool(companions)})
    notes = os.path.join(home, '.config', 'agent', 'environment.md')
    os.makedirs(os.path.dirname(notes), exist_ok=True)
    with open(notes, 'w') as f:
        f.write(text + '\n')
    for path, body in (
        (os.path.join(home, '.claude', 'CLAUDE.md'), f'@{notes}'),
        (os.path.join(home, '.codex', 'AGENTS.md'), text),
    ):
        os.makedirs(os.path.dirname(path), exist_ok=True)
        current = _raw(path)
        if current is None and os.path.exists(path):
            continue
        refreshed = refresh_block(current or '', body)
        if refreshed is not None:
            if refreshed != current:
                with open(path, 'w', encoding='utf-8', newline='') as f:
                    f.write(refreshed)
            continue
        if current and (notes in current or any(marker in current for marker in ALREADY_TOLD)):
            continue  # told some other way before
        with open(path, 'a', encoding='utf-8', newline='') as f:
            f.write(('\n\n' if (current or '').strip() else '') + f'{BLOCK_BEGIN}\n{body}\n{BLOCK_END}\n')


def skill_roots(home):
    codex_home = os.environ.get('CODEX_HOME') or os.path.join(home, '.codex')
    return [os.path.join(home, '.claude', 'skills'), os.path.join(codex_home, 'skills')]


def install_skills(src, home):
    """Copy each skill into every root, replacing only our own folders -> skipped paths."""
    skipped = []
    for name in sorted(os.listdir(src)) if os.path.isdir(src) else []:
        for root in skill_roots(home):
            dest = os.path.join(root, name)
            if os.path.exists(dest) and not os.path.exists(os.path.join(dest, MANAGED)):
                skipped.append(dest)
                continue
            shutil.rmtree(dest, ignore_errors=True)
            shutil.copytree(os.path.join(src, name), dest)
            with open(os.path.join(dest, MANAGED), 'w') as f:
                f.write('Installed by agentlab on every start; edits here are overwritten.\n')
    return skipped


def main():
    match sys.argv[1:]:
        case ['codex', path, command]:
            write_codex(path, command)
        case ['notes', agent, *flags] if set(flags) <= {'--android'}:
            companions = [c.strip() for c in os.environ.get('AGENTLAB_COMPANIONS', '').split(',') if c.strip()]
            write_notes(agent, os.path.expanduser('~'), android='--android' in flags, companions=companions)
        case ['skills']:
            for path in install_skills(SKILLS, os.path.expanduser('~')):
                print(f'skill not installed: {path} exists and is not ours', file=sys.stderr)
        case _:
            print(__doc__, file=sys.stderr)
            sys.exit(2)


if __name__ == '__main__':
    main()
