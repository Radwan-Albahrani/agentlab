#!/bin/bash
# Root half of agent-dockerd: the one command, without arguments, the agent may run with sudo
# (/etc/sudoers.d/agent-dockerd). Its socket is root:docker 0660, so only the agent (group docker) reaches it.
# Refuses outside a user namespace: without Sysbox, root here would be the host's root.
set -eu
read -r inside outside count < /proc/self/uid_map
if [ "${inside} ${outside} ${count}" = "0 0 4294967295" ]; then
  echo "agent-dockerd-root: not in a user namespace (no Sysbox), refusing to run dockerd as root" >&2
  exit 1
fi
exec /usr/bin/dockerd -H unix:///run/user/1000/dockerd.sock --group docker
