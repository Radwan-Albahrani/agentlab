#!/usr/bin/env python3
"""Stops orphans (re-parented to init, not supervisord's) that used no CPU for JANITOR_IDLE_MINUTES."""

import contextlib
import os
import signal
import subprocess
import time

IDLE_S = int(os.environ.get('JANITOR_IDLE_MINUTES', '10')) * 60
CHECK_EVERY_S = 60


def log(msg):
    print(time.strftime('%F %T'), msg, flush=True)


def read_proc(pid):
    """-> (parent pid, start time, cpu ticks, command line), or None for a kernel thread."""
    with open(f'/proc/{pid}/stat') as f:
        stat = f.read()
    fields = stat[stat.rindex(')') + 2 :].split()
    with open(f'/proc/{pid}/cmdline', 'rb') as f:
        cmd = f.read().replace(b'\0', b' ').decode(errors='replace').strip()
    if not cmd:
        return None
    return int(fields[1]), int(fields[19]), int(fields[11]) + int(fields[12]), cmd


def orphans():
    out = {}
    for name in filter(str.isdigit, os.listdir('/proc')):
        try:
            info = read_proc(name)
        except (OSError, ValueError, IndexError):
            continue
        if info and info[0] == 1 and name != '1':
            out[int(name)] = info[1:]
    return out


def supervised():
    out = subprocess.run(
        ['supervisorctl', '-c', '/etc/agent-supervisord.conf', 'pid', 'all'],
        capture_output=True,
        text=True,
        check=False,
    ).stdout
    return {int(x) for x in out.split() if x.isdigit()} | {os.getpid()}


def stop(pid, cmd):
    log(f'stopping idle orphan {pid} (no CPU for {IDLE_S // 60} min): {cmd[:150]}')
    with contextlib.suppress(OSError):
        os.kill(pid, signal.SIGTERM)


def main():
    seen = {}  # pid -> (start, cpu, idle since)
    log('janitor started')
    while True:
        now, keep, current = time.time(), supervised(), orphans()
        for pid, (start, cpu, cmd) in current.items():
            if pid in keep:
                continue
            prev = seen.get(pid)
            if not prev or prev[:2] != (start, cpu):
                seen[pid] = (start, cpu, now)
            elif now - prev[2] >= IDLE_S:
                stop(pid, cmd)
                seen.pop(pid)
        seen = {p: v for p, v in seen.items() if p in current}
        time.sleep(CHECK_EVERY_S)


if __name__ == '__main__':
    main()
